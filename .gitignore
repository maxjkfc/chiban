.env
.env.*
!.env.example
.DS_Store

# Node
node_modules/
.next/
next-env.d.ts

# Go
/apps/api/bin/

# Test-tool artifacts
.playwright-mcp/

# Local backups
/backups/

# Cloudflare Tunnel credentials. The tunnel's own config.yml is committed —
# the routing belongs in review — but the JSON beside it is the key to the
# tunnel and must never be.
deploy/cloudflared/*.json

# Design canvas build output. The artboards and the generator are committed;
# the seeded page carries a ~2.5 MB copy of the canvas editor, and the proof
# sheet is regenerated by `node gen.mjs`.
/.design/**/chiban-*.html
/.design/**/proof.html
/.design/**/proof.png
/.design/**/shot.mjs
