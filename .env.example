# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=chiban
POSTGRES_PASSWORD=chiban
POSTGRES_DB=chiban
POSTGRES_PORT=15432

# --- fake-gcs-server ---
FAKE_GCS_PORT=14443

# --- API ---
API_PORT=18080

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
# The one browser origin the API accepts credentialed requests from.
WEB_ORIGIN=http://localhost:3000
# Must be true once the site is served over HTTPS (Cloudflare Tunnel).
SECURE_COOKIES=false

# --- Cloudflare Tunnel (only for the Mac mini deployment) ---
# docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- Running api/web from source on the host ---
# `make run-api` and `make test` set these for you; listed here so they are
# discoverable. Go does not read .env, so exporting them by hand means
# `set -a; source .env; set +a`.
CHIBAN_DATABASE_URL=postgres://chiban:chiban@localhost:15432/chiban?sslmode=disable
CHIBAN_STORAGE_EMULATOR_HOST=http://localhost:14443

# The test suite truncates every table and rolls migrations back to zero, so it
# uses a throwaway database, never the one the app runs on.
CHIBAN_TEST_DATABASE_URL=postgres://chiban:chiban@localhost:15432/chiban_test?sslmode=disable
CHIBAN_TEST_STORAGE_EMULATOR_HOST=http://localhost:14443
