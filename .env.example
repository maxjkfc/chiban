# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=chiban
POSTGRES_PASSWORD=chiban
POSTGRES_DB=chiban
POSTGRES_PORT=15432

# --- fake-gcs-server ---
FAKE_GCS_PORT=14443

# --- API ---
API_PORT=18080

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
# The one browser origin the API accepts credentialed requests from.
WEB_ORIGIN=http://localhost:3000

# --- Cloudflare Tunnel (only for the Mac mini deployment) ---
# docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- Running the Go test suite from the host ---
# `make test` sets these for you; listed here so they are discoverable.
CHIBAN_TEST_DATABASE_URL=postgres://chiban:chiban@localhost:15432/chiban?sslmode=disable
CHIBAN_TEST_STORAGE_EMULATOR_HOST=http://localhost:14443
