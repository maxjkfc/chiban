# Copy to .env and adjust. Never commit .env.
#
# Values must not contain `#` or `$`: the Makefile includes this file directly
# and GNU Make would treat them as a comment and a variable reference.
# This file holds primitives only. Ports, URLs and DSNs used by the Go code are
# derived from them by the Makefile and docker-compose.yml, so each port is
# defined exactly once.

# --- PostgreSQL ---
POSTGRES_USER=chiban
POSTGRES_PASSWORD=chiban
POSTGRES_DB=chiban
POSTGRES_PORT=15432

# --- fake-gcs-server ---
FAKE_GCS_PORT=14443

# --- API ---
API_PORT=18080

# --- Web ---
WEB_PORT=3000
# Where the browser reaches the API. Defaults to http://localhost:$API_PORT;
# set it only for the deployment, where it is the public URL.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# The one browser origin the API accepts credentialed requests from.
WEB_ORIGIN=http://localhost:3000
# Must be true once the site is served over HTTPS (Cloudflare Tunnel).
SECURE_COOKIES=false

# --- Deployment (Mac mini behind Cloudflare Tunnel) ---
# See docs/DEPLOYMENT.md. Only this token is needed here: the deployment
# overrides in docker-compose.deploy.yml carry everything else, and the domain
# lives in the Cloudflare dashboard rather than in this repository.
#
#   docker compose -f docker-compose.yml -f docker-compose.deploy.yml \
#     --profile tunnel up -d --build
#
CLOUDFLARE_TUNNEL_TOKEN=
# Where the single origin is published on the host, for checking the
# deployment from the Mac mini itself. Loopback only; the public path is the
# tunnel.
EDGE_PORT=8090

# --- Running api/web from source on the host ---
# The CHIBAN_* variables are derived from the values above by the Makefile, so
# each port is defined in exactly one place. Use `make run-api` / `make test`;
# see the Makefile if you need to export them by hand.
